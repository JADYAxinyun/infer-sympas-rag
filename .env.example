# Optional DeepSeek provider only. Never put a real key in this file or commit .env.
DEEPSEEK_API_KEY=your-api-key
DEEPSEEK_MODEL=deepseek-flash
# Optional local built Infer/SymPas; otherwise `infer` is used from PATH.
INFER_BIN=/absolute/path/to/infer
# Live tests require explicit opt-in; default tests never call DeepSeek.
RUN_DEEPSEEK_LIVE=0
