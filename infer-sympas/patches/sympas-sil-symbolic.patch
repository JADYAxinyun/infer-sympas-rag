@@ -0,0 +1,10 @@
+/* Loop regression: the backward analysis must converge and retain x. */
+int accumulate(int x) {
+  int i = 0;
+  int total = x;
+  while (i < 3) {
+    total = total + 1;
+    i = i + 1;
+  }
+  return total;
+}
