+"""Regression tests for slice-only evaluation of mixed Infer reports."""
+import unittest
+
+from evaluate_smoke import structure_finding
+
+
+class StructureFindingTest(unittest.TestCase):
+    def test_summary_and_control_locations(self):
+        issue = {
+            "procedure": "helper",
+            "qualifier": (
+                "frontier={ x }; slice_locations={ line 3, column 2 }; "
+                "path_conditions={ }; global_dependencies={ }; "
+                "candidate summary: {formal[0]}; "
+                "precise control locations: { line 2, column 5 }"
+            ),
+        }
+        actual = structure_finding(issue)
+        self.assertEqual(actual["summary"], "formal[0]")
+        self.assertEqual(actual["control_locations"], "line 2, column 5")
