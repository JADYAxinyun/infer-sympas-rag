@@ -0,0 +1,13 @@
+/* Two call sites must preserve their caller-side dependencies. */
+int helper(int x) {
+  return x + 1;
+}
+
+int choose(int left, int right) {
+  int first = helper(left);
+  int second = helper(right);
+  if (first < second) {
+    return first;
+  }
+  return second;
+}
