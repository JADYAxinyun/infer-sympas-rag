@@ -0,0 +1,40 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Run the small regression corpus against the locally built Infer binary.
+ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
+INFER="$ROOT/infer/bin/infer"
+OUT="$(mktemp -d "${TMPDIR:-/tmp}/infer-sympas-smoke.XXXXXX")"
+trap 'rm -rf "$OUT"' EXIT
+
+if [[ ! -x "$INFER" ]]; then
+  echo "Infer binary not found: $INFER" >&2
+  echo "Build it first with: make -j2" >&2
+  exit 1
+fi
+
+run_case() {
+  local source="$1"
+  local result_dir="$OUT/$(basename "$source" .c)"
+  "$INFER" --sympas-only --results-dir "$result_dir" -- clang -c "$ROOT/$source" >/dev/null
+  test -s "$result_dir/report.json"
+  grep -q 'SYMPAS_SLICE' "$result_dir/report.json"
+  echo "PASS $source"
+}
+
+run_case examples/sympas/summary_propagation.c
+grep -q 'formal\[0\]' "$OUT/summary_propagation/report.json"
+run_case examples/sympas/multiple_calls.c
+grep -q 'formal\[1\]' "$OUT/multiple_calls/report.json"
+run_case examples/sympas/global_dependency.c
+grep -q 'global_limit' "$OUT/global_dependency/report.json"
+run_case examples/sympas/loop.c
+grep -q 'frontier={ x }' "$OUT/loop/report.json"
+run_case examples/sympas/recursive.c
+grep -q 'formal\[0\]' "$OUT/recursive/report.json"
+run_case examples/sympas/pointer_alias.c
+grep -q 'formal\[0\]' "$OUT/pointer_alias/report.json"
+run_case examples/sympas/aggregate_memory.c
+grep -q 'formal\[0\]' "$OUT/aggregate_memory/report.json"
+
+echo "All SymPas smoke tests passed."
diff --git a/examples/sympas/summary_propagation.c b/examples/sympas/summary_propagation.c
new file mode 100644
index 0000000000..a208ea4256
--- /dev/null
+++ b/examples/sympas/summary_propagation.c
@@ -0,0 +1,43 @@
+/* Minimal cross-procedure SymPas slicing example. */
+int helper(int x) {
+  int y = x - 10;
+  return y;
+}
+
+int unrelated(int z) {
+  return z * 2;
+}
+
+int check(int a, int b) {
+  int r = helper(a);
+  int unused = unrelated(b);
+  if (r < 0) {
+    return r;
+  }
+  return 0;
+}
+
+int bump(int *p) {
+  *p = *p + 1;
+  return *p;
+}
+
+int check_ptr(int x) {
+  return bump(&x);
+}
+
+int choose_first(int a, int b) {
+  int selected = helper(a);
+  int ignored = helper(b);
+  return selected;
+}
+
+int shared_limit = 10;
+
+int add_limit(int x) {
+  return x + shared_limit;
+}
+
+int check_global(int x) {
+  return add_limit(x);
+}
