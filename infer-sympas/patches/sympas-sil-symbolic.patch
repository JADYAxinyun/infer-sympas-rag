new file mode 100644
index 0000000000..a92965c4a3
--- /dev/null
+++ b/examples/sympas/recursive.c
@@ -0,0 +1,11 @@
+/* Recursion regression: summaries should reach a fixed point. */
+int descend(int value, int steps) {
+  if (steps <= 0) {
+    return value;
+  }
+  return descend(value + 1, steps - 1);
+}
+
+int recursive_entry(int input) {
+  return descend(input, 2);
+}
