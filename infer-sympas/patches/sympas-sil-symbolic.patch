+/* Pointer alias regression: q aliases p and the write affects the return. */
+int write_through(int *p) {
+  int *q = p;
+  *q = 7;
+  return *p;
+}
+
+int alias_entry(int input) {
+  int value = input;
+  return write_through(&value);
+}
