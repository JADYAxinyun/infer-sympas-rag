index 0000000000..a156594fef
--- /dev/null
+++ b/examples/sympas/aggregate_memory.c
@@ -0,0 +1,16 @@
+/* Aggregate-memory regression: field and array writes should be retained. */
+struct Box {
+  int value;
+};
+
+int read_box(struct Box *box) {
+  box->value = box->value + 1;
+  return box->value;
+}
+
+int aggregate_entry(int input) {
+  struct Box box;
+  int values[2] = {input, 0};
+  box.value = values[0];
+  return read_box(&box);
+}
diff --git a/examples/sympas/evaluate_smoke.py b/examples/sympas/evaluate_smoke.py
new file mode 100644
index 0000000000..419a0be9f0
--- /dev/null
+++ b/examples/sympas/evaluate_smoke.py
@@ -0,0 +1,95 @@
+#!/usr/bin/env python3
+"""Measure the small SymPas regression corpus.
+
+This is not a precision benchmark; it records reproducible smoke-test cost and
+the number of emitted slice findings for future comparisons.
+"""
+from __future__ import annotations
+
+import json
+import subprocess
+import tempfile
+import time
+from pathlib import Path
+import re
+
+
+ROOT = Path(__file__).resolve().parents[2]
+MANIFEST = Path(__file__).with_name("expected_dependencies.json")
+CASES = [
+    "summary_propagation.c",
+    "multiple_calls.c",
+    "global_dependency.c",
+    "loop.c",
+    "recursive.c",
+    "pointer_alias.c",
+    "aggregate_memory.c",
+]
+
+
+def extract(qualifier: str, label: str, next_label: str) -> str:
+    suffix = rf"\s*;?\s*{re.escape(next_label)}" if next_label else r".*$"
+    match = re.search(rf"{re.escape(label)}\s*=?\s*\{{(.*?)\}}{suffix}", qualifier, re.S)
+    if not match:
+        return ""
+    value = " ".join(match.group(1).split()).strip()
+    return value.strip("}").strip()
+
+
+def structure_finding(finding: dict) -> dict:
+    qualifier = finding.get("qualifier", "")
+    return {
+        "procedure": finding.get("procedure"),
+        "file": finding.get("file"),
+        "line": finding.get("line"),
+        "frontier": extract(qualifier, "frontier=", "slice_locations"),
+        "slice_locations": extract(qualifier, "slice_locations=", "path_conditions"),
+        "globals": extract(qualifier, "global_dependencies=", "candidate summary"),
+        "summary": extract(qualifier, "candidate summary:", "precise control locations"),
+        "control_locations": extract(qualifier, "precise control locations:", ""),
+    }
+
+
+def main() -> None:
+    infer = ROOT / "infer" / "bin" / "infer"
+    if not infer.exists():
+        raise SystemExit("Infer binary not found; run make -j2 first")
+
+    expected = json.loads(MANIFEST.read_text())
+    rows = []
+    checks = []
+    with tempfile.TemporaryDirectory(prefix="infer-sympas-eval-") as tmp:
+        for filename in CASES:
+            result_dir = Path(tmp) / Path(filename).stem
+            source = Path(__file__).parent / filename
+            started = time.perf_counter()
+            subprocess.run(
+                [str(infer), "--sympas-only", "--results-dir", str(result_dir), "--", "clang", "-c", str(source)],
+                check=True,
+                stdout=subprocess.DEVNULL,
+                stderr=subprocess.STDOUT,
+            )
+            elapsed_ms = round((time.perf_counter() - started) * 1000, 2)
+            report = json.loads((result_dir / "report.json").read_text())
+            slices = [finding for finding in report if finding.get("bug_type") == "SYMPAS_SLICE"]
+            structured = [structure_finding(finding) for finding in slices]
+            for procedure, expected_summary in expected.get(filename, {}).items():
+                actual = next((item["summary"].replace(" ", "") for item in structured if item["procedure"] == procedure), "")
+                expected_normalized = expected_summary.replace(" ", "")
+                checks.append({"case": filename, "procedure": procedure, "expected": expected_normalized, "actual": actual, "ok": actual == expected_normalized})
+            rows.append({
+                "case": filename,
+                "findings": len(slices),
+                "other_findings": len(report) - len(slices),
+                "elapsed_ms": elapsed_ms,
+                "structured_findings": structured,
+            })
+
+    result = {"cases": rows, "dependency_checks": checks, "total_findings": sum(row["findings"] for row in rows)}
+    print(json.dumps(result, indent=2))
+    if not all(check["ok"] for check in checks):
+        raise SystemExit("dependency manifest check failed")
+
+
+if __name__ == "__main__":
+    main()
